# Connection string from Supabase > Project Settings > Database.
# Keep this secret on the backend; never expose it with a VITE_ prefix.
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Required only for the first administrator setup; remove it after use.
AIREA_ADMIN_SETUP_TOKEN=
AIREA_JWT_SECRET=
AIREA_PUBLIC_ORIGIN=https://your-site.example
